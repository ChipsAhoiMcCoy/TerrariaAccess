Mods: {
	TerrariaAccess: {
		Configs: {
			TerrariaAccessConfig: {
				DisplayName: Terraria Access Settings

				EdgeDetectionMode: {
					Label: Edge Detection
					Tooltip: Controls how you're warned about drop-offs (3+ tiles deep) while walking. Static plays white noise that gets louder as you approach. Beeps plays high-pitched tones at a fixed rate. Both indicate direction and stop when you stop moving.
					Off.Label: Off
					Static.Label: Static
					Beeps.Label: Beeps
				}

				OverheadTraversalCuesEnabled: {
					Label: Overhead Traversal Cues
					Tooltip: When enabled, footsteps play a companion tone when you are directly underneath a nearby rope, platform, or minecart track that you can use.
				}

				CursorTileSounds: {
					Label: Cursor Tile Sounds
					Tooltip: When enabled, Smart Cursor emits a sound when it focuses a new tile. Disable to silence tile focus sounds.
				}

				FootstepVolume: {
					Label: Footstep Volume
					Tooltip: Adjusts the volume of footstep audio cues including walking sounds and edge detection tones.
				}

				EnemySoundVolume: {
					Label: Enemy Sound Volume
					Tooltip: Adjusts the volume of enemy proximity audio cues that indicate nearby hostile creatures.
				}

				GuidanceVolume: {
					Label: Guidance Volume
					Tooltip: Adjusts the volume of guidance system audio cues used for waypoints, NPCs, and other tracking targets.
				}

				GuidanceAllMode: {
					Label: Guidance All Mode
					Tooltip: Controls how pings play when a guidance category (such as Items, Critters, Plants, or Custom) is set to the All option. Sweep plays a ping for every tracked target in a left-to-right sweep. Nearest Only plays a single ping for the closest target each cycle.
					Sweep.Label: Sweep
					NearestOnly.Label: Nearest Only
				}

				InteractableCueVolume: {
					Label: Interactable Cue Volume
					Tooltip: Adjusts the volume of audio cues for nearby interactable objects like chests, doors, and crafting stations.
				}

				CursorVolume: {
					Label: Cursor Volume
					Tooltip: Adjusts the volume of the tones that play when the cursor navigates to a tile.
				}

				AnnounceDamageNumbers: {
					Label: Announce Damage Numbers
					Tooltip: Announces the damage numbers you deal to hostile NPCs.
				}

				BossWarningsEnabled: {
					Label: Boss Warnings
					Tooltip: Announces selected boss attack windups and dangerous projectiles with brief dodge guidance.
				}

				SpatialInventoryAudio: {
					Label: Experimental Spatial Inventory Audio
					Tooltip: Experimental feature. When enabled, inventory navigation clicks use panning (left/right) and pitch (high/low) to indicate slot position.
				}

				MultiplayerFootstepsEnabled: {
					Label: Multiplayer Footsteps
					Tooltip: When enabled, plays spatialized footstep sounds for other players in multiplayer. The sounds use panning and pitch to indicate player positions relative to you.
				}

				MultiplayerFootstepVolume: {
					Label: Multiplayer Footstep Volume
					Tooltip: Adjusts the volume of footstep sounds for other players in multiplayer.
				}

				CavitySonarEnabled: {
					Label: Cavity Sonar
					Tooltip: When enabled, press the Cavity Sonar keybind to scan the area around you. A left-to-right sweep plays tones for empty spaces, revealing cave shapes and openings.
				}

				CavitySonarVolume: {
					Label: Cavity Sonar Volume
					Tooltip: Adjusts the volume of the cavity sonar sweep tones.
				}

				ChunkMinerEnabled: {
					Label: Chunk Miner
					Tooltip: When enabled, mining an ore or gem will automatically mine all connected tiles of the same type in the vein. Great for quickly harvesting resource deposits.
				}

				ChunkMinerMaxTiles: {
					Label: Chunk Miner Max Tiles
					Tooltip: Maximum number of tiles that can be mined at once when chunk mining. Higher values allow larger veins to be mined in one hit, but may cause brief lag on very large deposits.
				}

				WallCollisionEnabled: {
					Label: Wall Collision
					Tooltip: When enabled, plays a repeating tap sound when you walk into a solid wall. The tap is panned toward the wall so you can tell which side is blocked.
				}

				WallCollisionVolume: {
					Label: Wall Collision Volume
					Tooltip: Adjusts the volume of the wall collision tap sounds.
				}

				FallDetectionEnabled: {
					Label: Fall Detection
					Tooltip: When enabled, plays audio cues while falling to indicate ground proximity and warn about fall damage.
				}

				FallDetectionMode: {
					Label: Fall Detection Mode
					Tooltip: Controls the type of audio cue played during falls. Tone plays a continuous rising-pitch sound as you approach the ground. Beeps plays accelerating pips that speed up as you get closer.
					Tone.Label: Tone
					Beeps.Label: Beeps
				}

				FallDetectionVolume: {
					Label: Fall Detection Volume
					Tooltip: Adjusts the volume of fall detection audio cues including proximity tones and fall damage warnings.
				}
			}
		}

