LogitechLedEnginesWrapper.dll
ReLogic.Native.dll
SteelSeriesEngineWrapper.dll
Terraria.exe
TerrariaServer.exe
changelog.txt
client-crashlog.txt
dotNetFx40_Full_setup.exe
dotNetFx40_Full_x86_x64.exe
installscript.vdf
