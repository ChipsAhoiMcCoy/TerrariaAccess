# Ignore unpacked game assets and tModLoader distribution
Content/
tModLoader_dist/
tModLoader.zip

# Ignore local build outputs
*.tmod
*.orig
*.log

# Ignore .NET build output
**/bin/
**/obj/

# Ignore tooling dumps of decompiled Terraria code
Tools/Decompiled/
TModLoader Decompiled/
Terraria Decompiled/
.tmp_ilspy_*/

# Ignore portable .NET SDK and dotnet tools used by decompile-terraria.ps1
Tools/dotnet/
Tools/dotnet-tools/

# Ignore installer build output (but keep bundled release files)
Release/Output/
!Release/files/**/*.tmod

# Ignore local Claude Code settings
.claude/
Agents.md
nul
tmpclaude-*
Optimization.md

# Ignore local Codex navigation notes and scratch files
.codex-local/
