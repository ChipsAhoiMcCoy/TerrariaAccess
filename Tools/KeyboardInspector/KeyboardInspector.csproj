<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TmlRoot>C:\Program Files (x86)\Steam\steamapps\common\tModLoader</TmlRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="tModLoader">
      <HintPath>$(TmlRoot)\tModLoader.dll</HintPath>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(TmlRoot)\Libraries\FNA\1.0.0\FNA.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
